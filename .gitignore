# Scratch workspace: plan, evidence reports, RESULTS rollup.
# All local-only; not version-controlled.
.scratch/

# build artifacts — single `out/` prefix (refactor §2):
#   out/bin, out/halide, out/lib, out/record. A bare `zig build` (no -p) would
#   still spawn zig-out/; keep it ignored too.
out/
zig-out/
.zig-cache/

# python venv (halide generator + analysis notebook deps)
.venv/

# jupyter checkpoints
.ipynb_checkpoints/

# report data (derived; rebuilt by scripts/build_report.py)
experiments/report/data.parquet
*.duckdb
