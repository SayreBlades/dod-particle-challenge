# L1 cells to sweep (one per line; lines starting with # are ignored).
# Full cell names (L1.<strat>) — collect.sh splits on the first dot.
# Source of truth: experiments/cells/L1.md (regenerated by `zig build manifests`).
# Halide cells need `uv sync --extra halide`; collect.sh skips any cell whose
# build fails, so a missing venv degrades gracefully (the Zig cells still run).
# Parallel cells (strats containing -par / rmerge) are auto-swept across THREADS
# (default {1,4,10}) by collect.sh; serial cells run T=1 only.

# --- B1 (math+decide+respawn | render) ---
L1.B1.w1-autovec.w2-simple
L1.B1.w1-autovec.w2-opt
L1.B1.w1-scalar.w2-simple
L1.B1.w1-autovec-par.w2-simple
L1.B1.w1-blend.w2-simple
L1.B1.w1-blend-par.w2-simple
L1.B1.w1-halide.w2-simple
L1.B1.w1-halide.w2-opt
L1.B1.w1-halide-par.w2-simple

# --- B2 (math | decide+respawn | render) ---
L1.B2.w1-autovec.w2-simple
L1.B2.w1-autovec-par.w2-simple
L1.B2.w1-halide.w2-simple
L1.B2.w1-halide-par.w2-simple

# --- B3 (math+decide→mask | scan+respawn | render) ---
L1.B3.w1-autovec.w2-simple
L1.B3.w1-autovec-par.w2-rmerge
L1.B3.w1-halide.w2-simple

# --- B4 (math+decide→list | respawn-dead | render) ---
L1.B4.w1-autovec.w2-simple
L1.B4.w1-autovec-par.w2-rmerge

# --- B5–B8 (fused render; framebuffer-only golden) ---
L1.B5.w1-fused
L1.B6.w1-autovec.w2-fused
L1.B7.w1-autovec.w2-fused
L1.B8.w1-autovec.w2-fused