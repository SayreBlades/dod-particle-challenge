# L1 cells to sweep (one per line; lines starting with # are ignored).
# Full cell names (L1.<strat>) — matching what the bench emits and collect.sh
# splits on the first dot: layout=L1, strat=B1.w1-autovec.w2-simple.
# Source of truth: experiments/cells/L1.md (regenerated by `zig build manifests`).
# Halide cells require the .venv (uv sync --extra halide);
# collect.sh skips any cell whose build fails, so a missing venv degrades
# gracefully (the three Zig cells still run).
L1.B1.w1-autovec.w2-simple
L1.B1.w1-autovec.w2-opt
L1.B1.w1-scalar.w2-simple
L1.B1.w1-halide.w2-simple
L1.B1.w1-halide.w2-opt
L1.B3.w1-autovec-par.w2-rmerge
