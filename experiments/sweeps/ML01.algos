# ML01 algorithms to sweep (one per line; lines starting with # are ignored).
# Full algorithm names (ML01.<algo>) — collect.py splits on the first dot.
# Source of truth: the algo_meta in each strategy file (§8); `zig build manifests`
# prints the registered roster.
# Halide algorithms need `uv sync`; collect.py skips any algorithm
# whose build fails, so a missing venv degrades gracefully (the Zig algorithms
# still run).
# Parallel algorithms (algos containing -par / rmerge) are auto-swept across
# THREADS (default {1,4,10}) by collect.py; serial algorithms run T=1 only.

# --- AF01 (Integrate+Decide+Respawn+Render — fully fused) ---
ML01.AF01.LP1-fused

# --- AF02 (Integrate+Decide+Respawn | Render — reference family) ---
ML01.AF02.LP1-autovec.LP2-simple
ML01.AF02.LP1-autovec.LP2-opt
ML01.AF02.LP1-scalar.LP2-simple
ML01.AF02.LP1-unroll.LP2-simple
ML01.AF02.LP1-autovec-par.LP2-simple
ML01.AF02.LP1-blend.LP2-simple
ML01.AF02.LP1-blend-par.LP2-simple
ML01.AF02.LP1-halide.LP2-simple
ML01.AF02.LP1-halide.LP2-opt
ML01.AF02.LP1-halide-par.LP2-simple

# --- AF03 (Integrate+Decide | Respawn+Render) ---
ML01.AF03.LP1-autovec.LP2-fused

# --- AF04 (Integrate | Decide+Respawn+Render) ---
ML01.AF04.LP1-autovec.LP2-fused

# --- AF05 (Integrate | Decide+Respawn | Render — natural seam) ---
ML01.AF05.LP1-autovec.LP2-simple
ML01.AF05.LP1-autovec-par.LP2-simple
ML01.AF05.LP1-halide.LP2-simple
ML01.AF05.LP1-halide-par.LP2-simple

# --- AF06 (Integrate+Decide | Respawn | Render — mask/list variants) ---
ML01.AF06.LP1-autovec.LP2-mask
ML01.AF06.LP1-autovec-par.LP2-mask-rmerge
ML01.AF06.LP1-halide.LP2-mask
ML01.AF06.LP1-autovec.LP2-list
ML01.AF06.LP1-autovec-par.LP2-list-rmerge
ML01.AF06.LP1-autovec.LP2-list-fused
